# ====================================================================
# TELEGRAM BOT KONFIGURATSIYA SHABLONI (RENDER.COM UCHUN)
# Ushbu fayldagi o'zgaruvchilarni Render.com ning "Environment" bo'limiga kiriting.
# ====================================================================

# 1. Telegram Bot Token (@BotFather dan olinadi) - MAJBURIY
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_Example

# 2. Asosiy Admin Telegram ID raqami (masalan: 6125160021) - MAJBURIY
ADMIN_ID=6125160021
# Bir nechta admin bo'lsa (ixtiyoriy):
ADMIN_IDS=6125160021

# 3. Google Gemini AI API Kaliti (https://aistudio.google.com/app/apikey) - MAJBURIY
GEMINI_API_KEY=AIzaSyExampleKeyFromGoogleAIStudio123456

# 4. Gemini Modeli (tavsiya etiladi: gemini-3.8-flash yoki gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# 5. Groq AI API Kaliti (https://console.groq.com/keys) - MAJBURIY (0.3 soniyali tezkor moderatsiya va zaxira)
GROQ_API_KEY=gsk_ExampleKeyFromGroqConsole1234567890abcdef

# 6. YouTube Data API v3 Kaliti (Google Cloud Console orqali olinadi) - TAVSIYA ETILADI
YOUTUBE_API_KEY=AIzaSyExampleKeyForYouTubeDataAPIv3_123456

# 7. Obunalar to'lovi uchun karta ma'lumotlari (ixtiyoriy, keyin bot ichidan ham o'zgartirsa bo'ladi)
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Admin Ismi

# 8. Render Port sozlamasi (Render Web Service sifatida ochilganda avtomatik beriladi)
# PORT=10000
